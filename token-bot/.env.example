# Copy to .env and fill in. NEVER commit .env.

# Telegram bot token from @BotFather
BOT_TOKEN=

# Comma-separated Telegram user IDs allowed to use the bot (required).
# The bot pays deployment fees from PAYER_PRIVATE_KEY, so an open bot can be drained.
ALLOWED_USER_IDS=123456789

# Solana
SOLANA_CLUSTER=devnet            # devnet | mainnet-beta
SOLANA_RPC_URL=https://api.devnet.solana.com
# Hot wallet that pays rent + fees. Base58 secret key or JSON byte array ([12,34,...]).
PAYER_PRIVATE_KEY=
# Priority fee in micro-lamports per compute unit
PRIORITY_FEE_MICROLAMPORTS=50000
# Refuse to deploy if payer balance is below this (SOL)
MIN_PAYER_BALANCE_SOL=0.05

# Pinata (IPFS) for logo + off-chain metadata JSON
PINATA_JWT=
PINATA_GATEWAY=https://gateway.pinata.cloud/ipfs/

# pump.fun bonding-curve launches (create_v2 + optional creator buy, one transaction)
PUMP_ENABLED=true
# Fee rate assumed when sizing the first buy (bps). Must be >= pump.fun's real rate, or preflight rejects the buy.
PUMP_FEE_BPS=300
PUMP_MAX_DEV_BUY_SOL=5
# Address lookup table for pump.fun accounts. Leave empty: the bot creates one on the
# first launch and saves it to PUMP_LOOKUP_TABLE_FILE.
PUMP_LOOKUP_TABLE=
PUMP_LOOKUP_TABLE_FILE=pump_lookup_table.txt
