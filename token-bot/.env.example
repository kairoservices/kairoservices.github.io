# Copy to .env and fill in. NEVER commit .env.

# Telegram bot token from @BotFather
BOT_TOKEN=

# Comma-separated Telegram user IDs allowed to use the bot (required).
# The bot pays deployment fees from PAYER_PRIVATE_KEY, so an open bot can be drained.
ALLOWED_USER_IDS=123456789

# Solana
SOLANA_CLUSTER=devnet            # devnet | mainnet-beta
SOLANA_RPC_URL=https://api.devnet.solana.com
# Hot wallet that pays rent + fees. Base58 secret key or JSON byte array ([12,34,...]).
PAYER_PRIVATE_KEY=
# Priority fee in micro-lamports per compute unit
PRIORITY_FEE_MICROLAMPORTS=50000
# Refuse to deploy if payer balance is below this (SOL)
MIN_PAYER_BALANCE_SOL=0.05

# Pinata (IPFS) for logo + off-chain metadata JSON
PINATA_JWT=
PINATA_GATEWAY=https://gateway.pinata.cloud/ipfs/
