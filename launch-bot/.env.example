BOT_TOKEN=123456:replace-me
# Telegram user IDs. ADMIN_IDS can create tokens/pools; OWNER_IDS (subset) can also withdraw/burn LP and move SOL.
ADMIN_IDS=111111111
OWNER_IDS=111111111

# Start on devnet. For mainnet use a dedicated RPC provider, not the public endpoint.
RPC_URL=https://api.devnet.solana.com
WALLETS_DIR=./wallets
MASTER_WALLET=master
STATE_FILE=./launches.json

# Raydium CPMM. Defaults are MAINNET values; set the devnet program/fee receiver when testing on devnet.
# RAYDIUM_CPMM_PROGRAM=CPMMoo8L3F4NbTegBCKVNunggL7H1ZpdTHKxQB5qKP1C
# RAYDIUM_CPMM_FEE_RECEIVER=DNXgeM9EiiaAbaWvwjHj9fQQLAX5ZsfHyvmYUNRAdNC8
RAYDIUM_CPMM_CONFIG_INDEX=0

PRIORITY_FEE_MICRO_LAMPORTS=50000
CONFIRM_TIMEOUT_S=90
PENDING_TTL_S=120
